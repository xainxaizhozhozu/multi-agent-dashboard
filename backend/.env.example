# ── Mock Mode ──
# true = use built-in mock data (no API key needed)
# false = call real LLM API
USE_MOCK_MODE=true

# ── OpenAI-compatible API ──
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Examples for other providers:
# DashScope (Qwen): OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 MODEL_NAME=qwen-plus
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1 MODEL_NAME=deepseek-chat
